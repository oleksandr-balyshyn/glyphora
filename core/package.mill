package build.core

import mill.*
import mill.javalib.DepSyntax

object `package` extends build.TuiPublishModule {

  def artifactName = "tui-core"

  def moduleDescription =
    "Foundational types for the tui Scala 3 TUI library: Buffer, Rect, Style, Layout, Widget traits."

  object test extends TuiTests {
    // ScalaCheck 1.18 -> 1.19 alongside ScalaTest 3.2.20: org.scalatestplus:scalacheck-1-18 has no 3.2.20.0
    // release (it stops at 3.2.19.0) — the ScalaTest-version-matched artifact is renamed for the ScalaCheck minor
    // it wraps, not just re-tagged, so a version-only bump here would fail to resolve.
    def extraTestDeps = Seq(mvn"org.scalatestplus::scalacheck-1-19:3.2.20.0")
  }
}
