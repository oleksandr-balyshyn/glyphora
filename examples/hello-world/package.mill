package build.examples.`hello-world`

import mill.*

// Everything an example has in common — the GraalVM pin, `--no-fallback`, and a Pilot-capable
// test submodule — lives in `TuiExampleModule` in build.mill.
object `package` extends build.TuiExampleModule {

  // Transitive: `build.dsl` already depends on core, terminal, widgets, runtime and macros, so naming those
  // here changed nothing and drifted into lying (two examples omitted `build.widgets` and used it anyway).
  def moduleDeps = Seq(build.dsl)

  def mainClass = Some("io.worxbend.tui.examples.helloworld.Main")
}
