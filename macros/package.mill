package build.macros

import mill.*

object `package` extends build.TuiPublishModule {

  def artifactName = "tui-macros"

  def moduleDescription =
    "Compile-time codegen for the tui library: form derivation and action binding without runtime reflection."

  // No `moduleDeps`: compile-time derivation of forms and actions is pure `scala.deriving`/`scala.quoted`
  // work over the caller's own types, so it names nothing from `tui-core`. Declaring a dependency it does
  // not use would make every consumer of `tui-macros` pull `tui-core` for nothing.
  def moduleDeps = Seq.empty

  object test extends TuiTests
}
